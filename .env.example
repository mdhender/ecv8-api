# Copy to .env.development.local (git-ignored) and edit.
#
# Precedence, highest first:
#   1. a command-line flag        --listen-addr 127.0.0.1:3000
#   2. a real environment variable
#   3. a dotenv file, in this order:
#        .env.{EC_ENV}.local   git-ignored, may hold secrets
#        .env.local            git-ignored, may hold secrets
#        .env.{EC_ENV}         tracked, never put a secret here
#        .env                  tracked, never put a secret here
#   4. the built-in default
#
# A dotenv file never overrides a variable that is already set.

# Which dotenv files load. One of development, test, production, agent.
EC_ENV=development

# --- Database -----------------------------------------------------------
# Directory holding ecv8.db. The filename is fixed and the directory must
# already exist; the server never creates one.
EC_DB_PATH=db

# --- Initial administrator ----------------------------------------------
# Read only by `ecdb create`, and only when the database is created.
# Set both or neither: setting exactly one is a configuration error and no
# database is created. Opening an existing database ignores these entirely.
# Keep them in a .local file, never in a tracked one.
#EC_ADMIN_EMAIL=admin@example.com
#EC_ADMIN_SECRET=change-me

# --- HTTP ---------------------------------------------------------------
# Private listener. TLS is terminated by nginx in production and by Caddy in
# development, so this stays plain HTTP on a loopback address.
EC_LISTEN_ADDR=127.0.0.1:3000

# The origin browsers use. Activation links are built from it, so it must match
# what users actually type, including the port.
EC_PUBLIC_BASE_URL=https://ecv8.localhost:8443

# --- Session cookie -----------------------------------------------------
# Secure defaults to true and should stay that way. The development origin
# above is HTTPS (Caddy's internal CA), so nothing needs switching off.
#
# Set EC_COOKIE_SECURE=false only if you fall back to a plain-http origin,
# because a browser silently discards a Secure cookie sent over http.
#EC_COOKIE_SECURE=false
#EC_COOKIE_NAME=ec_session
#EC_COOKIE_SAMESITE=lax
#EC_SESSION_TTL=168h
#EC_SESSION_IDLE_TTL=24h

# --- Reverse proxy ------------------------------------------------------
# CIDR blocks whose X-Forwarded-For may be believed. Leave unset to ignore
# forwarding headers entirely and use the socket's peer address.
#EC_TRUSTED_PROXY=127.0.0.1/32

# --- Logging ------------------------------------------------------------
EC_LOG_LEVEL=debug
EC_LOG_FORMAT=text
